# ============================================================================
#  site-monitor 环境变量。复制为 .env 后填写；.env 已被 gitignore。
#  只有「登录前就必须知道」的配置在这里；Umami / Google 凭证在页面的引导流程里配置。
# ============================================================================

# 对外访问地址（Pocket ID 回调 = 这个地址 + /auth/callback，需要在 Pocket ID 里登记）
SM_BASE_URL=https://monitor.example.com

# Pocket ID（OIDC）—— 唯一的登录方式
SM_OIDC_ISSUER=https://id.example.com
SM_OIDC_CLIENT_ID=
SM_OIDC_CLIENT_SECRET=

# 会话签名 + 凭证加密的主密钥。生成：python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
# 更换后已保存的凭证会失效，需要在页面上重新配置。
SM_SECRET_KEY=

# SQLite 路径（容器内默认 /data/site-monitor.db）
# SM_DB_PATH=./data/site-monitor.db

# 关闭内置定时同步（调试用）
# SM_SCHEDULER=0
